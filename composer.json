{
    "name": "lequocanh/shop",
    "description": "LeQuocAnh Shop - E-commerce System",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "tecnickcom/tcpdf": "^6.6",
        "phpoffice/phpspreadsheet": "^1.29",
        "phpmailer/phpmailer": "^7.0",
        "firebase/php-jwt": "^6.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7",
        "phpunit/phpunit": "11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "lequocanh/app/"
        },
        "classmap": [
            "lequocanh/administrator/elements_LQA/mod/"
        ]
    },
    "scripts": {
        "analyse": "phpstan analyse lequocanh/app lequocanh/includes lequocanh/api --level=4 --memory-limit=256M",
        "cs-check": "phpcs lequocanh/app --standard=PSR12 --ignore=*/vendor/*",
        "cs-fix": "phpcbf lequocanh/app --standard=PSR12 --ignore=*/vendor/*",
        "test": "phpunit --configuration phpunit.xml",
        "test-coverage": "phpunit --configuration phpunit.xml --coverage-clover=coverage.xml"
    },
    "config": {
        "audit": {
            "ignore": ["PKSA-z3gr-8qht-p93v"]
        }
    }
}
