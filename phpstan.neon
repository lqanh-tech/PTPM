parameters:
    level: 4
    paths:
        - lequocanh/app
        - lequocanh/includes
        - lequocanh/api
    excludePaths:
        - */vendor/*
        - */cache/*
        - */graphify-out/*
        - */node_modules/*
    bootstrapFiles:
        - lequocanh/includes/helpers.php
        - lequocanh/cache/QueryCache.php
    ignoreErrors:
        # Legacy classes loaded via require (not autoload)
        - '#on an unknown class (Database|SessionManager|GioHang|CacheManager|ConfigManager)#'
        - '#Instantiated class (GioHang) not found.#'
        - '#Unsafe usage of new static\(\)#'
        - '#Comparison operation ">" between int<1, max> and 0 is always true.#'
